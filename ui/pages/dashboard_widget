from pathlib import Path

from PySide6.QtWidgets import (
    QWidget,
    QVBoxLayout,
    QLabel,
)


class DashboardWidget(QWidget):

    def __init__(self):

        super().__init__()


        layout = QVBoxLayout(
            self
        )


        self.title = QLabel(
            "🐻 BearCore Status"
        )


        self.status = QLabel()

        self.modules = QLabel()

        self.templates = QLabel()

        self.backup = QLabel()



        layout.addWidget(
            self.title
        )

        layout.addWidget(
            self.status
        )

        layout.addWidget(
            self.modules
        )

        layout.addWidget(
            self.templates
        )

        layout.addWidget(
            self.backup
        )


        self.refresh()



    def refresh(self):

        base = Path(__file__).resolve().parent.parent.parent


        modules = (
            base /
            "modules"
        )


        templates = (
            base /
            "templates"
        )


        module_count = 0

        template_count = 0


        if modules.exists():

            module_count = len(
                [
                    x for x in modules.iterdir()
                    if x.is_dir()
                    and x.name != "__pycache__"
                ]
            )


        if templates.exists():

            template_count = len(
                [
                    x for x in templates.iterdir()
                    if x.is_dir()
                ]
            )



        self.status.setText(
            "🟢 Online"
        )

        self.modules.setText(
            f"📦 Moduuleita: {module_count}"
        )

        self.templates.setText(
            f"📚 Templateja: {template_count}"
        )

        self.backup.setText(
            "💾 Backup: OK"
        )